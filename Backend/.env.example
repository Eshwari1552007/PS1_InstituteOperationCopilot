PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
FIREBASE_PROJECT_ID=edupilot-80fa2
OWNER_EMAIL=owner@example.com
OWNER_NAME=EDUPILOT Owner
# Set only for first-time provisioning. Use a unique password with 12+ characters.
OWNER_INITIAL_PASSWORD=
# Optional for local development. Prefer Application Default Credentials when available.
GOOGLE_APPLICATION_CREDENTIALS=./config/serviceAccountKey.json
# On Render, set this to the complete service-account JSON as a private environment variable.
# Leave blank when using GOOGLE_APPLICATION_CREDENTIALS or Application Default Credentials.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Explicitly enable only while developing locally; endpoints are disabled in production.
ENABLE_FIRESTORE_TEST_ENDPOINTS=false
# Demo enrollment payments are allowed locally but are blocked in production by default.
ENABLE_DEMO_PAYMENTS=false

# EDUPILOT Copilot provider order. The primary is tried first; fallback providers
# are attempted when the previous key is rejected, rate-limited, or unavailable.
AI_PROVIDER=gemini
# Keep all three API keys in this server-only .env. Only a provider being tried
# receives the question and minimized summary. Leave model overrides blank to use defaults.
AI_FALLBACK_PROVIDERS=openai,deepseek
AI_MODEL=
GEMINI_MODEL=
OPENAI_MODEL=
DEEPSEEK_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
