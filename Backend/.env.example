PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
FIREBASE_PROJECT_ID=edupilot-80fa2
OWNER_EMAIL=owner@example.com
OWNER_NAME=EDUPILOT Owner
# Set only for first-time provisioning. Use a unique password with 12+ characters.
OWNER_INITIAL_PASSWORD=
# Optional for local development. Prefer Application Default Credentials when available.
GOOGLE_APPLICATION_CREDENTIALS=./config/serviceAccountKey.json
# Explicitly enable only while developing locally; endpoints are disabled in production.
ENABLE_FIRESTORE_TEST_ENDPOINTS=false
