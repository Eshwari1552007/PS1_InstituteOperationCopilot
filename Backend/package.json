{
  "name": "edupilot-backend",
  "version": "1.0.0",
  "private": true,
  "description": "EDUPILOT Express API with Firebase Authentication and Cloud Firestore",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "audit:attendance": "node scripts/auditAttendance.js --dry-run",
    "backfill:offline-counts": "node scripts/backfillOfflineCounts.js",
    "seed:test-data": "node scripts/seedTestData.js",
    "provision-owner": "node scripts/provisionOwner.js"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^13.0.2"
  }
}
