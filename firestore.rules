rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'OWNER'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'APPROVED';
    }

    function isStudentManager() {
      return isOwner()
        || (signedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'COUNSELOR'
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'APPROVED');
    }

    function isCounselor() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'COUNSELOR'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'APPROVED';
    }

    function isTrainer() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'TRAINER'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'APPROVED';
    }

    function isStudent() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'STUDENT'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'APPROVED';
    }

    function isAccounts() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ACCOUNTS'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'APPROVED';
    }

    function canManageEnrollment() { return isOwner() || isCounselor(); }

    function validWeeklySessionDuration(batchId, data, allowReviewFlag) {
      let batch = get(/databases/$(database)/documents/batches/$(batchId)).data;
      return (allowReviewFlag && data.needsReview == true
          && data.diff(resource.data).affectedKeys().hasOnly(['needsReview', 'reviewReason', 'updatedAt']))
        || !('weeklyTeachingHours' in batch)
        || (batch.weeklyTeachingHours is int
          && batch.weeklyTeachingHours >= 1 && batch.weeklyTeachingHours <= 60
          && data.sessionIndex is int && data.sessionIndex >= 1
          && data.sessionIndex <= batch.weeklyTeachingHours
          && data.durationMinutes in [60, 120]);
    }

    function validStudent(studentId, data) {
      return studentId is string
        && data.keys().hasOnly([
          'studentId', 'fullName', 'email', 'phone', 'dateOfBirth', 'gender',
          'course', 'batch', 'admissionDate', 'status', 'address',
          'guardianName', 'guardianPhone', 'createdAt', 'updatedAt',
          'createdBy', 'updatedBy', 'courseDocId', 'courseId', 'batchDocId', 'batchId',
          'enrollmentStatus', 'isArchived', 'authUid', 'accountStatus'
        ])
        && data.keys().hasAll([
          'studentId', 'fullName', 'email', 'phone', 'dateOfBirth', 'gender',
          'course', 'batch', 'admissionDate', 'status', 'address',
          'guardianName', 'guardianPhone', 'createdAt', 'updatedAt',
          'createdBy', 'updatedBy', 'courseDocId', 'courseId', 'batchDocId', 'batchId',
          'enrollmentStatus', 'isArchived'
        ])
        && data.studentId.matches('^STU-[0-9]{4}-[0-9]{4,}$')
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120
        && data.email is string && data.email.size() <= 254
        && data.phone is string && data.phone.size() <= 40
        && data.dateOfBirth is string && data.dateOfBirth.size() <= 10
        && data.gender is string && data.gender.size() <= 40
        && data.course is string && data.course.size() <= 120
        && data.batch is string && data.batch.size() <= 120
        && data.admissionDate is string && data.admissionDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.status in ['ACTIVE', 'PENDING', 'INACTIVE']
        && data.address is string && data.address.size() <= 1000
        && data.guardianName is string && data.guardianName.size() <= 120
        && data.guardianPhone is string && data.guardianPhone.size() <= 40
        && data.createdBy is string && data.updatedBy is string
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.courseDocId is string
        && data.courseId is string && (data.courseId == '' || data.courseId.matches('^CRS-[0-9]{4}-[0-9]{4,}$'))
        && (data.batchDocId == null || data.batchDocId is string)
        && (data.batchId == null || data.batchId is string)
        && data.enrollmentStatus in ['ACTIVE', 'WITHDRAWN', 'TRANSFERRED', 'NONE']
        && data.isArchived is bool;
    }

    function validPublicProfile(uid) {
      return signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.role in ['STUDENT', 'COUNSELOR', 'TRAINER', 'ACCOUNTS']
        && request.resource.data.createdAt == request.time
        && (request.resource.data.role != 'STUDENT'
          || (request.resource.data.phone is string && request.resource.data.phone.matches('^\\+?[1-9][0-9]{7,14}$')))
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'phone', 'role', 'status', 'createdAt', 'approvedAt']);
    }

    match /users/{uid} {
      allow create: if validPublicProfile(uid)
        && ((request.resource.data.role == 'STUDENT'
              && request.resource.data.status == 'APPROVED'
              && request.resource.data.approvedAt == request.time)
            || (request.resource.data.role in ['COUNSELOR', 'TRAINER', 'ACCOUNTS']
              && request.resource.data.status == 'PENDING'
              && !('approvedAt' in request.resource.data)));

      allow get: if (signedIn() && request.auth.uid == uid) || isOwner();
      allow list: if isOwner();

      allow update: if isOwner()
        && resource.data.role in ['COUNSELOR', 'TRAINER', 'ACCOUNTS']
        && resource.data.status == 'PENDING'
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedAt', 'approvedBy', 'reviewedAt', 'rejectionReason'])
        && request.resource.data.status in ['APPROVED', 'REJECTED']
        && request.resource.data.approvedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && ((request.resource.data.status == 'APPROVED'
              && request.resource.data.approvedAt == request.time
              && request.resource.data.rejectionReason == null)
            || (request.resource.data.status == 'REJECTED'
              && request.resource.data.approvedAt == null
              && request.resource.data.rejectionReason is string
              && request.resource.data.rejectionReason.size() <= 500));

      allow delete: if false;
    }

    match /students/{studentId} {
      allow get, list: if isStudentManager()
        || (isStudent() && request.auth.uid == studentId)
        || (isTrainer() && resource.data.batchDocId != null
          && get(/databases/$(database)/documents/batches/$(resource.data.batchDocId)).data.teacherId == request.auth.uid);

      allow create: if (isStudentManager() || (isStudent() && request.auth.uid == studentId
          && request.resource.data.authUid == request.auth.uid
          && request.resource.data.email == request.auth.token.email))
        && validStudent(studentId, request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/studentIds/$(request.resource.data.studentId))
        && getAfter(/databases/$(database)/documents/studentIds/$(request.resource.data.studentId)).data.studentDocId == studentId
        && (!('authUid' in request.resource.data)
          || (request.resource.data.authUid == studentId
            && exists(/databases/$(database)/documents/users/$(request.resource.data.authUid))
            && get(/databases/$(database)/documents/users/$(request.resource.data.authUid)).data.role == 'STUDENT'
            && get(/databases/$(database)/documents/users/$(request.resource.data.authUid)).data.status == 'APPROVED'
            && get(/databases/$(database)/documents/users/$(request.resource.data.authUid)).data.email == request.resource.data.email));

      allow update: if isStudentManager()
        && validStudent(studentId, request.resource.data)
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isArchived'])
          || (isOwner() && request.resource.data.isArchived == true && resource.data.enrollmentStatus != 'ACTIVE'));
      allow delete: if false;
    }

    match /courses/{courseId} {
      allow get, list: if isStudentManager() || isTrainer() || isStudent();
      allow create, update: if isOwner();
      allow delete: if false;
    }

    match /batches/{batchId} {
      allow get, list: if isStudentManager() || isStudent() || (isTrainer() && resource.data.teacherId == request.auth.uid);
      allow create, delete: if isOwner();
      allow update: if isOwner() || (isCounselor()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'enrolledCount', 'offlineEnrolledCount', 'status', 'updatedAt', 'updatedBy', 'lastEnrollmentMutationId'
        ])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.enrolledCount >= 0
        && request.resource.data.offlineEnrolledCount >= 0
        && request.resource.data.offlineEnrolledCount <= (('offlineCapacity' in resource.data) ? resource.data.offlineCapacity : resource.data.capacity)
        && existsAfter(/databases/$(database)/documents/enrollments/$(request.resource.data.lastEnrollmentMutationId))
        && getAfter(/databases/$(database)/documents/enrollments/$(request.resource.data.lastEnrollmentMutationId)).data.batchDocId == batchId
        && ((request.resource.data.enrolledCount == resource.data.enrolledCount + 1
              && getAfter(/databases/$(database)/documents/enrollments/$(request.resource.data.lastEnrollmentMutationId)).data.status == 'ACTIVE'
              && request.resource.data.offlineEnrolledCount == (('offlineEnrolledCount' in resource.data) ? resource.data.offlineEnrolledCount : 0) + (getAfter(/databases/$(database)/documents/enrollments/$(request.resource.data.lastEnrollmentMutationId)).data.learningMode == 'OFFLINE' ? 1 : 0)
              && (getAfter(/databases/$(database)/documents/enrollments/$(request.resource.data.lastEnrollmentMutationId)).data.learningMode != 'OFFLINE'
                || (('offlineEnrolledCount' in resource.data) ? resource.data.offlineEnrolledCount : 0) < (('offlineCapacity' in resource.data) ? resource.data.offlineCapacity : resource.data.capacity)))
          || (request.resource.data.enrolledCount == resource.data.enrolledCount - 1
              && get(/databases/$(database)/documents/enrollments/$(request.resource.data.lastEnrollmentMutationId)).data.status == 'ACTIVE'
              && getAfter(/databases/$(database)/documents/enrollments/$(request.resource.data.lastEnrollmentMutationId)).data.status in ['TRANSFERRED', 'WITHDRAWN']
              && request.resource.data.offlineEnrolledCount == (('offlineEnrolledCount' in resource.data) ? resource.data.offlineEnrolledCount : (get(/databases/$(database)/documents/enrollments/$(request.resource.data.lastEnrollmentMutationId)).data.learningMode == 'OFFLINE' ? resource.data.enrolledCount : 0)) - (get(/databases/$(database)/documents/enrollments/$(request.resource.data.lastEnrollmentMutationId)).data.learningMode == 'OFFLINE' ? 1 : 0)))));
    }

    match /enrollments/{enrollmentId} {
      allow get: if isStudentManager()
        || (isStudent() && (!exists(/databases/$(database)/documents/enrollments/$(enrollmentId)) || resource.data.studentDocId == request.auth.uid))
        || (isTrainer() && (!exists(/databases/$(database)/documents/enrollments/$(enrollmentId)) || resource.data.teacherId == request.auth.uid));
      allow list: if isStudentManager() || (isStudent() && resource.data.studentDocId == request.auth.uid) || (isTrainer() && resource.data.teacherId == request.auth.uid);
      allow create: if canManageEnrollment()
        && request.resource.data.keys().hasOnly([
          'studentDocId', 'studentId', 'courseDocId', 'courseId', 'courseName', 'batchDocId', 'batchId', 'batchName',
          'studentName', 'studentEmail', 'studentPhone', 'status', 'learningMode', 'feeRecordId', 'teacherId',
          'enrolledAt', 'enrolledBy', 'updatedAt', 'updatedBy'
        ])
        && enrollmentId == request.resource.data.studentDocId + '__' + request.resource.data.batchDocId
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.enrolledBy == request.auth.uid
        && existsAfter(/databases/$(database)/documents/students/$(request.resource.data.studentDocId))
        && exists(/databases/$(database)/documents/courses/$(request.resource.data.courseDocId))
        && exists(/databases/$(database)/documents/batches/$(request.resource.data.batchDocId))
        && get(/databases/$(database)/documents/batches/$(request.resource.data.batchDocId)).data.courseDocId == request.resource.data.courseDocId
        && (request.resource.data.learningMode == 'ONLINE'
          || ((('offlineEnrolledCount' in get(/databases/$(database)/documents/batches/$(request.resource.data.batchDocId)).data)
                ? get(/databases/$(database)/documents/batches/$(request.resource.data.batchDocId)).data.offlineEnrolledCount
                : get(/databases/$(database)/documents/batches/$(request.resource.data.batchDocId)).data.enrolledCount)
            < (('offlineCapacity' in get(/databases/$(database)/documents/batches/$(request.resource.data.batchDocId)).data)
              ? get(/databases/$(database)/documents/batches/$(request.resource.data.batchDocId)).data.offlineCapacity
              : get(/databases/$(database)/documents/batches/$(request.resource.data.batchDocId)).data.capacity))
        && getAfter(/databases/$(database)/documents/batches/$(request.resource.data.batchDocId)).data.enrolledCount
          == get(/databases/$(database)/documents/batches/$(request.resource.data.batchDocId)).data.enrolledCount + 1
        && getAfter(/databases/$(database)/documents/students/$(request.resource.data.studentDocId)).data.studentId == request.resource.data.studentId
        && getAfter(/databases/$(database)/documents/students/$(request.resource.data.studentDocId)).data.batchDocId == request.resource.data.batchDocId
        && get(/databases/$(database)/documents/batches/$(request.resource.data.batchDocId)).data.isClosed != true
        && get(/databases/$(database)/documents/batches/$(request.resource.data.batchDocId)).data.isArchived != true
        && get(/databases/$(database)/documents/batches/$(request.resource.data.batchDocId)).data.status in ['ACTIVE', 'UPCOMING']
        && (('learningModes' in get(/databases/$(database)/documents/batches/$(request.resource.data.batchDocId)).data
              && request.resource.data.learningMode in get(/databases/$(database)/documents/batches/$(request.resource.data.batchDocId)).data.learningModes)
          || (!('learningModes' in get(/databases/$(database)/documents/batches/$(request.resource.data.batchDocId)).data)
              && request.resource.data.learningMode == 'OFFLINE'))
        && (request.resource.data.learningMode == 'ONLINE' || request.resource.data.learningMode == 'OFFLINE')
        && (!isStudent() || request.resource.data.studentDocId == getAfter(/databases/$(database)/documents/students/$(request.resource.data.studentDocId)).data.authUid)
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.teacherId == get(/databases/$(database)/documents/batches/$(request.resource.data.batchDocId)).data.teacherId
        && get(/databases/$(database)/documents/courses/$(request.resource.data.courseDocId)).data.status == 'ACTIVE'
        && existsAfter(/databases/$(database)/documents/feeRecords/$(request.resource.data.feeRecordId))
        && getAfter(/databases/$(database)/documents/feeRecords/$(request.resource.data.feeRecordId)).data.enrollmentId == enrollmentId
        && getAfter(/databases/$(database)/documents/feeRecords/$(request.resource.data.feeRecordId)).data.studentDocId == request.resource.data.studentDocId
        && getAfter(/databases/$(database)/documents/feeRecords/$(request.resource.data.feeRecordId)).data.amountPaid * 2 >= getAfter(/databases/$(database)/documents/feeRecords/$(request.resource.data.feeRecordId)).data.totalFee
        && (getAfter(/databases/$(database)/documents/feeRecords/$(request.resource.data.feeRecordId)).data.totalFee == 0
          || (getAfter(/databases/$(database)/documents/feeRecords/$(request.resource.data.feeRecordId)).data.lastPaymentId is string
            && existsAfter(/databases/$(database)/documents/payments/$(getAfter(/databases/$(database)/documents/feeRecords/$(request.resource.data.feeRecordId)).data.lastPaymentId))
            && getAfter(/databases/$(database)/documents/payments/$(getAfter(/databases/$(database)/documents/feeRecords/$(request.resource.data.feeRecordId)).data.lastPaymentId)).data.status == 'VERIFIED'))
        && request.resource.data.updatedAt == request.time;
      allow update: if canManageEnrollment()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedAt', 'updatedBy', 'studentName', 'studentEmail', 'studentPhone'
        ])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.status in ['ACTIVE', 'TRANSFERRED', 'WITHDRAWN']
        && ((resource.data.status == 'ACTIVE' && request.resource.data.status in ['TRANSFERRED', 'WITHDRAWN'])
          || (resource.data.status in ['TRANSFERRED', 'WITHDRAWN'] && request.resource.data.status == 'ACTIVE')
          || (resource.data.status == 'ACTIVE' && request.resource.data.status == 'ACTIVE'));
      allow delete: if false;
    }

    match /enrollmentHistory/{historyId} {
      allow get, list: if isStudentManager() || (isStudent() && resource.data.studentDocId == request.auth.uid);
      allow create: if canManageEnrollment()
        && request.resource.data.keys().hasOnly([
          'enrollmentId', 'studentDocId', 'studentId', 'studentName', 'courseName', 'courseDocId', 'batchId', 'batchName',
          'batchDocId', 'learningMode', 'enrolledAt', 'totalFee', 'amountPaid', 'remainingBalance', 'paymentStatus',
          'advancePaid', 'lastPaymentId', 'createdAt', 'updatedAt', 'action', 'actorUid', 'paymentId',
          'previousBatchDocId', 'newBatchDocId'
        ])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /studentIds/{studentId} {
      allow get: if canManageEnrollment() || (isStudent()
        && (!exists(/databases/$(database)/documents/studentIds/$(studentId)) || resource.data.studentDocId == request.auth.uid));
      allow create: if (canManageEnrollment() || (isStudent() && request.resource.data.studentDocId == request.auth.uid))
        && studentId.matches('^STU-[0-9]{4}-[0-9]{4,}$')
        && request.resource.data.studentDocId is string
        && existsAfter(/databases/$(database)/documents/students/$(request.resource.data.studentDocId))
        && getAfter(/databases/$(database)/documents/students/$(request.resource.data.studentDocId)).data.studentId == studentId;
      allow list, update, delete: if false;
    }

    match /sequences/{sequenceId} {
      allow get: if isOwner() || isCounselor() || isStudent();
      allow create: if (sequenceId.matches('^student-[0-9]{4}$') && (isOwner() || isCounselor() || isStudent())
        && request.resource.data.lastNumber == 1
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastStudentId.matches('^STU-[0-9]{4}-[0-9]{4,}$')
        && existsAfter(/databases/$(database)/documents/students/$(request.resource.data.lastStudentDocId))
        && getAfter(/databases/$(database)/documents/students/$(request.resource.data.lastStudentDocId)).data.studentId == request.resource.data.lastStudentId
        && existsAfter(/databases/$(database)/documents/studentIds/$(request.resource.data.lastStudentId))
        && getAfter(/databases/$(database)/documents/studentIds/$(request.resource.data.lastStudentId)).data.studentDocId == request.resource.data.lastStudentDocId);
      allow create: if isOwner() && !sequenceId.matches('^student-[0-9]{4}$')
        && request.resource.data.lastNumber == 1 && request.resource.data.updatedAt == request.time;
      allow update: if sequenceId.matches('^student-[0-9]{4}$') && (isOwner() || isCounselor() || isStudent())
        && request.resource.data.lastNumber == resource.data.lastNumber + 1
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastStudentId.matches('^STU-[0-9]{4}-[0-9]{4,}$')
        && existsAfter(/databases/$(database)/documents/students/$(request.resource.data.lastStudentDocId))
        && getAfter(/databases/$(database)/documents/students/$(request.resource.data.lastStudentDocId)).data.studentId == request.resource.data.lastStudentId
        && existsAfter(/databases/$(database)/documents/studentIds/$(request.resource.data.lastStudentId))
        && getAfter(/databases/$(database)/documents/studentIds/$(request.resource.data.lastStudentId)).data.studentDocId == request.resource.data.lastStudentDocId;
      allow update: if isOwner() && !sequenceId.matches('^student-[0-9]{4}$')
        && request.resource.data.lastNumber == resource.data.lastNumber + 1
        && request.resource.data.updatedAt == request.time;
      allow list, delete: if false;
    }

    match /scheduleLocks/{lockId} {
      allow get, list, create, update, delete: if isOwner();
    }

    match /feeRecords/{feeId} {
      allow get: if isStudentManager() || isAccounts()
        || (isStudent() && (!exists(/databases/$(database)/documents/feeRecords/$(feeId)) || resource.data.studentDocId == request.auth.uid));
      allow list: if isStudentManager() || isAccounts() || (isStudent() && resource.data.studentDocId == request.auth.uid);
      allow create: if canManageEnrollment()
        && existsAfter(/databases/$(database)/documents/enrollments/$(request.resource.data.enrollmentId))
        && getAfter(/databases/$(database)/documents/enrollments/$(request.resource.data.enrollmentId)).data.studentDocId == request.resource.data.studentDocId
        && getAfter(/databases/$(database)/documents/enrollments/$(request.resource.data.enrollmentId)).data.feeRecordId == feeId
        && request.resource.data.totalFee >= 0
        && request.resource.data.amountPaid >= 0 && request.resource.data.amountPaid <= request.resource.data.totalFee
        && request.resource.data.remainingBalance == request.resource.data.totalFee - request.resource.data.amountPaid
        && request.resource.data.paymentStatus == (request.resource.data.remainingBalance == 0 ? 'PAID' : 'PARTIALLY_PAID')
        && ((request.resource.data.totalFee == 0 && request.resource.data.amountPaid == 0)
          || (request.resource.data.amountPaid > 0 && request.resource.data.amountPaid * 2 >= request.resource.data.totalFee
            && request.resource.data.lastPaymentId is string
            && existsAfter(/databases/$(database)/documents/payments/$(request.resource.data.lastPaymentId))
            && getAfter(/databases/$(database)/documents/payments/$(request.resource.data.lastPaymentId)).data.feeRecordId == feeId
            && getAfter(/databases/$(database)/documents/payments/$(request.resource.data.lastPaymentId)).data.amount == request.resource.data.amountPaid
            && getAfter(/databases/$(database)/documents/payments/$(request.resource.data.lastPaymentId)).data.status == 'VERIFIED'))
        && ((('price' in get(/databases/$(database)/documents/batches/$(request.resource.data.batchDocId)).data)
              && request.resource.data.totalFee == get(/databases/$(database)/documents/batches/$(request.resource.data.batchDocId)).data.price)
          || (!('price' in get(/databases/$(database)/documents/batches/$(request.resource.data.batchDocId)).data)
              && request.resource.data.totalFee == get(/databases/$(database)/documents/courses/$(request.resource.data.courseDocId)).data.fee));
      allow update: if (isOwner() || isCounselor() || isAccounts())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amountPaid', 'remainingBalance', 'paymentStatus', 'updatedAt', 'updatedBy', 'lastPaymentId'])
        && request.resource.data.amountPaid == resource.data.amountPaid + getAfter(/databases/$(database)/documents/payments/$(request.resource.data.lastPaymentId)).data.amount
        && request.resource.data.remainingBalance == resource.data.totalFee - request.resource.data.amountPaid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.paymentStatus == (request.resource.data.remainingBalance == 0 ? 'PAID' : 'PARTIALLY_PAID')
        && request.resource.data.lastPaymentId is string
        && getAfter(/databases/$(database)/documents/payments/$(request.resource.data.lastPaymentId)).data.feeRecordId == feeId;
      allow delete: if false;
    }

    match /payments/{paymentId} {
      allow get, list: if isStudentManager() || isAccounts() || (isStudent() && resource.data.studentDocId == request.auth.uid);
      allow create: if (isOwner() || isCounselor() || isAccounts())
        && request.resource.data.keys().hasOnly([
          'feeRecordId', 'enrollmentId', 'studentDocId', 'studentId', 'batchDocId', 'amount', 'remainingBalance',
          'method', 'purpose', 'status', 'isDemo', 'reference', 'recordedBy', 'createdAt'
        ])
        && request.resource.data.status == 'VERIFIED'
        && request.resource.data.method == 'MANUAL'
        && request.resource.data.isDemo == false
        && request.resource.data.purpose in ['ADVANCE', 'TUITION']
        && request.resource.data.recordedBy == request.auth.uid
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.createdAt == request.time
        && (request.resource.data.reference == null || (request.resource.data.reference is string && request.resource.data.reference.size() <= 120))
        && request.resource.data.studentDocId == getAfter(/databases/$(database)/documents/feeRecords/$(request.resource.data.feeRecordId)).data.studentDocId
        && request.resource.data.enrollmentId == getAfter(/databases/$(database)/documents/feeRecords/$(request.resource.data.feeRecordId)).data.enrollmentId
        && request.resource.data.amount <= getAfter(/databases/$(database)/documents/feeRecords/$(request.resource.data.feeRecordId)).data.totalFee
        && getAfter(/databases/$(database)/documents/feeRecords/$(request.resource.data.feeRecordId)).data.lastPaymentId == paymentId
        && request.resource.data.remainingBalance == getAfter(/databases/$(database)/documents/feeRecords/$(request.resource.data.feeRecordId)).data.remainingBalance
        && ((exists(/databases/$(database)/documents/feeRecords/$(request.resource.data.feeRecordId))
              && request.resource.data.amount <= get(/databases/$(database)/documents/feeRecords/$(request.resource.data.feeRecordId)).data.remainingBalance
              && getAfter(/databases/$(database)/documents/feeRecords/$(request.resource.data.feeRecordId)).data.amountPaid
                == get(/databases/$(database)/documents/feeRecords/$(request.resource.data.feeRecordId)).data.amountPaid + request.resource.data.amount)
          || (!exists(/databases/$(database)/documents/feeRecords/$(request.resource.data.feeRecordId))
              && getAfter(/databases/$(database)/documents/feeRecords/$(request.resource.data.feeRecordId)).data.amountPaid == request.resource.data.amount));
      allow update, delete: if false;
    }

    // Legacy payment PIN records remain inaccessible; current payment confirmation uses Firebase Authentication reauthentication.
    match /demoPaymentPins/{studentUid} {
      allow read, write: if false;
    }

    match /attendanceSessions/{sessionId} {
      allow get, list: if isStudentManager()
        || (isTrainer() && resource.data.teacherId == request.auth.uid)
        || (isStudent() && resource.data.status in ['OPEN', 'COMPLETED', 'CANCELLED']
          && exists(/databases/$(database)/documents/enrollments/$(request.auth.uid + '__' + resource.data.batchDocId))
          && get(/databases/$(database)/documents/enrollments/$(request.auth.uid + '__' + resource.data.batchDocId)).data.studentDocId == request.auth.uid);
      // Attendance occurrence creation and all status changes are validated by
      // the authenticated Admin SDK attendance API against the published timetable.
      allow create, update, delete: if false;
    }

    match /attendanceRecords/{recordId} {
      allow get: if isStudentManager()
        || (isStudent() && resource.data.studentDocId == request.auth.uid)
        || (isTrainer() && resource.data.teacherId == request.auth.uid);
      allow list: if isStudentManager() || (isStudent() && resource.data.studentDocId == request.auth.uid)
        || (isTrainer() && resource.data.teacherId == request.auth.uid);
      // Direct client writes are prohibited; trusted API validates role, session,
      // enrollment eligibility, deterministic record IDs and audit metadata.
      allow create, update, delete: if false;
    }

    match /timetableSettings/{settingsId} {
      allow get, list: if isOwner() || isTrainer() || isStudent();
      allow create, update: if isOwner() && settingsId == 'main'
        && request.resource.data.keys().hasOnly(['workingDays', 'openTime', 'closeTime', 'slotIncrement', 'breaks', 'rooms', 'holidays', 'timeZone', 'updatedAt'])
        && request.resource.data.workingDays is list && request.resource.data.workingDays.size() <= 7
        && request.resource.data.rooms is list && request.resource.data.rooms.size() <= 100
        && request.resource.data.breaks is list && request.resource.data.breaks.size() <= 30
        && (!('holidays' in request.resource.data) || (request.resource.data.holidays is list && request.resource.data.holidays.size() <= 366))
        && request.resource.data.slotIncrement in [15, 30, 60]
        && request.resource.data.openTime is string && request.resource.data.closeTime is string
        && (!('timeZone' in request.resource.data) || (request.resource.data.timeZone is string && request.resource.data.timeZone.size() <= 80))
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /timetableSessions/{sessionId} {
      allow get: if isOwner() || isTrainer()
        || (isStudent() && exists(/databases/$(database)/documents/enrollments/$(request.auth.uid + '__' + resource.data.batchDocId))
          && get(/databases/$(database)/documents/enrollments/$(request.auth.uid + '__' + resource.data.batchDocId)).data.status == 'ACTIVE'
          && resource.data.status == 'PUBLISHED');
      allow list: if isOwner() || isTrainer()
        || (isStudent() && resource.data.status == 'PUBLISHED'
          && exists(/databases/$(database)/documents/enrollments/$(request.auth.uid + '__' + resource.data.batchDocId))
          && get(/databases/$(database)/documents/enrollments/$(request.auth.uid + '__' + resource.data.batchDocId)).data.status == 'ACTIVE');
      allow create: if isOwner()
        && request.resource.data.batchDocId is string
        && exists(/databases/$(database)/documents/batches/$(request.resource.data.batchDocId))
        && request.resource.data.teacherId is string
        && exists(/databases/$(database)/documents/users/$(request.resource.data.teacherId))
        && get(/databases/$(database)/documents/users/$(request.resource.data.teacherId)).data.role == 'TRAINER'
        && get(/databases/$(database)/documents/users/$(request.resource.data.teacherId)).data.status == 'APPROVED'
        && request.resource.data.day in ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun']
        && request.resource.data.startMinutes is int && request.resource.data.endMinutes is int
        && request.resource.data.durationMinutes is int
        && request.resource.data.durationMinutes > 0
        && request.resource.data.endMinutes - request.resource.data.startMinutes == request.resource.data.durationMinutes
        && request.resource.data.roomId is string
        && request.resource.data.source in ['GENERATED', 'MANUAL']
        && request.resource.data.status in ['DRAFT', 'PUBLISHED']
        && exists(/databases/$(database)/documents/timetableSettings/main)
        && request.resource.data.day in get(/databases/$(database)/documents/timetableSettings/main).data.workingDays
        && validWeeklySessionDuration(request.resource.data.batchDocId, request.resource.data, false)
        && request.resource.data.needsReview != true;
      allow update: if isOwner()
        && request.resource.data.batchDocId == resource.data.batchDocId
        && request.resource.data.endMinutes - request.resource.data.startMinutes == request.resource.data.durationMinutes
        && request.resource.data.teacherId is string
        && exists(/databases/$(database)/documents/users/$(request.resource.data.teacherId))
        && get(/databases/$(database)/documents/users/$(request.resource.data.teacherId)).data.role == 'TRAINER'
        && get(/databases/$(database)/documents/users/$(request.resource.data.teacherId)).data.status == 'APPROVED'
        && request.resource.data.day in get(/databases/$(database)/documents/timetableSettings/main).data.workingDays
        && validWeeklySessionDuration(request.resource.data.batchDocId, request.resource.data, true)
        && (request.resource.data.needsReview != true || request.resource.data.status == resource.data.status)
        && request.resource.data.status in ['DRAFT', 'PUBLISHED'];
      allow delete: if isOwner() && resource.data.status != 'PUBLISHED';
    }

    // All other collections remain private unless explicitly authorized above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
